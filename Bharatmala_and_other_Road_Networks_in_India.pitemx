ugc noopener noreferrer'>free trial of ArcGIS<\/a>&nbsp;or a&nbsp;<a style='border:0px solid currentcolor; box-sizing:border-box; color:rgb(0, 121, 193); font-family:inherit; line-height:1.5; text-decoration:none;' target='_blank' href='https://goto.arcgis.com/developers/signup' rel='nofollow ugc noopener noreferrer'>free ArcGIS Developer account<\/a>.<\/p><\/div><\/div>","culture":"en-us","properties":null,"advancedSettings":null,"url":"https://livingatlas.esri.in/server/rest/services/Road_Network/Road_Centerline_Bharatmala/MapServer/0","proxyFilter":null,"access":"public","size":100,"subInfo":0,"appCategories":[],"industries":[],"languages":[],"largeThumbnail":null,"banner":null,"screenshots":[],"listed":false,"numComments":0,"numRatings":0,"avgRating":0,"numViews":42434,"scoreCompleteness":100,"groupDesignations":"livingatlas","apiToken1ExpirationDate":-1,"apiToken2ExpirationDate":-1,"lastViewed":1790575200000,"portalUrl":"https://www.arcgis.com/sharing"}