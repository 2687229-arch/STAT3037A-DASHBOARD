# --- Server ---
server <- function(input, output, session) {
  
  # Base map
  output$map <- renderLeaflet({
    leaflet() %>%
      addProviderTiles("Esri.WorldImagery") %>%
      addRasterImage(India_slope_50, colors = terrain.colors(100), group = "Slope") %>%
      addRasterImage(India_aspect_50, colors = topo.colors(100), group = "Aspect") %>%
      addPolygons(data = Indiaview_1984, fillColor="gray",color="black",
                  weight=1, group="Regions of India Near the Himalayas") %>%
      addPolylines(data = Indiaview_full_1984, color="black", weight=2, group="Map of India") %>%
      addCircleMarkers(data = Glacierview_1984, radius=0.5, fillColor="white",color="black", weight=1, fillOpacity=1, 
                       opacity=1, group="Glaciers of the Himalayas") %>%
      addPolylines(data = Roadsview_1984 %>% dplyr::filter(rdtype == "National Highway"),
                   color = "yellow", weight = 1.5, group = "National Highways") %>%
      addPolylines(data=Roadsview_1984 %>% dplyr::filter(rdtype == "State Highway"),
                   color = "white", weight = 1, group = "State Highways" ) %>%
      addPolylines(data = Riverview_1984, color="darkblue", weight=1, group="Rivers") %>%
      addPolygons(data = HPview_1984, fillColor="#7A4988",color="black", weight=1, group="Himachal Pradesh") %>%
      addPolygons(data = JKview_1984, fillColor="purple", color="black",weight=1, group="Jammu and Kashmir") %>%
      addPolygons(data = Lview_1984, fillColor="magenta",color="black",weight=1, group="Ladakh") %>%
      addPolygons(data = Uview_1984, fillColor="pink",color="black",weight=1, group="Uttarakhand") %>%
      addLegend(position = "bottomleft",
                colors = c("gray", "#7A4988","purple","magenta","pink","yellow",
                           "white","darkblue","aliceblue"), 
                labels = c("Regions", "Himachel Pradesh","Jammu and Kashmir","Ladakh","Uttarakhand",
                           "National Highway","State Highway","Rivers", "Glaciers"),
                title = "Map Layers") %>%
      addLayersControl(overlayGroups = c("Outline of India","Regions of India Near the Himalayas",
                                         "Himachal Pradesh","Jammu and Kashmir",
                                         "Ladakh","Uttarakhand","National Highways", "State Highways","Slope", "Aspect",
                                         "Rivers","Glaciers of the Himalayas"),
                       options = layersControlOptions(collapsed = FALSE))
     
  })
  
  lisa_results <- reactiveVal(NULL)
  # --- LISA Analysis (with progress bar) ---
  observeEvent(input$run_lisa, {
    selected_regions <- Indiaview_1984 %>% dplyr::filter(shapeName %in% input$regions_selected)
    if (nrow(selected_regions) == 0) {
      showNotification("No matching regions found.", type="error"); return()
    }
    
    # Show progress bar
    withProgress(message = "Running LISA analysis...", value = 0, {
      
      # Step 1: Build neighbors
      incProgress(0.3, detail = "Building spatial weights...")
      nb <- if (input$contiguity_selected == "Queen") {
        poly2nb(selected_regions, queen = TRUE)
      } else if (input$contiguity_selected == "Rook") {
        poly2nb(selected_regions, queen = FALSE)
      } else {
        coords <- st_coordinates(st_centroid(selected_regions))
        knn2nb(knearneigh(coords, k = 4))
      }
      
      # Step 2: Create weights
      incProgress(0.6, detail = "Computing weights...")
      lw <- nb2listw(nb, style="W")
      
      # Step 3: Run LISA
      incProgress(0.9, detail = "Running local Moran's I...")
      x <- as.numeric(selected_regions$your_numeric_column)  # replace with actual numeric field
      lisa_result <- localmoran(x, lw)
      
      # Step 4: Update results
      incProgress(1, detail = "Updating map...")
      selected_regions$lisa_cluster <- lisa_result[,5]
      lisa_results(selected_regions)
      
      leafletProxy("map") %>%
        clearGroup("LISA") %>%
        addPolygons(data = selected_regions,
                    fillColor = ~colorFactor(c("red","blue","pink","lightblue"),
                                             selected_regions$lisa_cluster)(lisa_cluster),
                    color="black", weight=1, group="LISA",
                    popup=~paste("Region:", shapeName, "<br>",
                                 "Cluster:", lisa_cluster))
    })
    
    showNotification("LISA analysis complete!", type = "message", duration = 5)
  })
  
  

  # --- Download Handler ---
  output$download_lisa <- downloadHandler(
    filename = function() {
      fmt <- input$output_format
      ext <- switch(fmt,
                    "CSV" = ".csv",
                    "Shapefile" = ".zip",
                    "GeoJSON" = ".geojson")
      paste0("LISA_results_", Sys.Date(), ext)
    },
    content = function(file) {
      results <- lisa_results()
      if (is.null(results)) return()
      fmt <- input$output_format
      if (fmt == "CSV") {
        write.csv(st_drop_geometry(results), file, row.names = FALSE)
      } else if (fmt == "Shapefile") {
        tmpdir <- tempdir()
        shpfile <- file.path(tmpdir, "LISA_results.shp")
        st_write(results, shpfile, delete_layer = TRUE)
        zip::zip(file, files = list.files(tmpdir, pattern="LISA_results", full.names=TRUE))
      } else if (fmt == "GeoJSON") {
        st_write(results, file, driver = "GeoJSON", delete_layer = TRUE)
      }
    }
  )
  
  # --- Disaster Risk ---
  observeEvent(input$run_risk, {
    river_buffer <- st_buffer(Rivers_clean, dist = as.numeric(input$river_distance)) |> 
      st_union() |> st_sf()
    glacier_buffer <- st_buffer(glacierview_clean, dist = as.numeric(input$glacier_radius)) |> 
      st_union() |> st_sf()
    
    river_buffer_1984 <- st_transform(river_buffer, 4326)
    glacier_buffer_1984 <- st_transform(glacier_buffer, 4326)
    
    leafletProxy("map") %>%
      clearGroup("River Risk Distance") %>%
      clearGroup("Glacier Search Radius") %>%
      addPolygons(data = river_buffer_1984,
                  color = "blue", weight = 2,
                  fillColor = "blue", fillOpacity = 0.2,
                  group = "River Risk Distance") %>%
      addPolygons(data = glacier_buffer_1984,
                  color = "red", weight = 2,
                  fillColor = "red", fillOpacity = 0.2,
                  group = "Glacier Search Radius")
    
    showNotification(
      paste("Disaster Risk Analysis:",
            "River Distance =", input$river_distance, "m |",
            "Glacier Radius =", input$glacier_radius, "m |",
            "Slope =", input$slope_range[1], "to", input$slope_range[2], "degrees"),
      type = "message", duration = 5
    )
  })
  
  # --- Evacuation ---
  observeEvent(input$run_evacuation, {
    road_buffer <- st_buffer(Roads_clean, dist = as.numeric(input$road_distance)) |> 
      st_union() |> st_sf()
    road_buffer_1984 <- st_transform(road_buffer, 4326)
    
    leafletProxy("map") %>%
      clearGroup("Evacuation Road Distance") %>%
      addPolygons(data = road_buffer_1984,
                  color = "green", weight = 2,
                  fillColor = "green", fillOpacity = 0.2,
                  group = "Evacuation Road Distance",
                  popup = paste("Distance:", input$road_distance, "m"))
    
    showNotification(
      paste("Evacuation Analysis:", input$road_distance, "m from road"),
      type = "message", duration = 5
    )
  })
}

# --- Run the app ---
shinyApp(ui = ui, server = server)



